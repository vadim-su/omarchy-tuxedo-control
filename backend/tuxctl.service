[Unit]
Description=TUXEDO laptop control (fan curves, saved settings)
After=systemd-modules-load.service
ConditionPathExists=/dev/tuxedo_io

[Service]
ExecStart=/usr/local/bin/tuxctl daemon
RuntimeDirectory=tuxctl
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
